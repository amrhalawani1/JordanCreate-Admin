NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public website that hosts the admin preview pages (/preview/speaker). Local dev: http://localhost:3001
NEXT_PUBLIC_WEBSITE_ORIGIN=https://www.jordancreate.com

# Website Analytics (optional). Keyless: the deployed admin signs in to Google with its Vercel identity.
# Numeric GA4 property id, not the G-XXXX measurement id.
GA4_PROPERTY_ID=
# Read-only service account with Viewer access on the GA4 property.
GA_SERVICE_ACCOUNT_EMAIL=
# projects/<number>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
GCP_WORKLOAD_IDENTITY_PROVIDER=
# Optional instead of the keyless pair above, where an organization allows key files. Secret.
# GA_SERVICE_ACCOUNT_KEY=
